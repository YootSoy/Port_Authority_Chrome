{
  "name": "Port Authority",
  "description": "Blocks websites from using JavaScript to port scan your computer/network and learns CNAME-discovered tracking aliases on Chrome.",
  "version": "3.1.0",
  "manifest_version": 3,
  "minimum_chrome_version": "101",

  "homepage_url": "https://github.com/YootSoy/Port_Authority_Chrome",

  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "96": "icons/logo-96.png"
  },

  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "webRequest",
    "declarativeNetRequest"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "options_page": "settings/settings.html",

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Port Authority",
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/prewarm-bridge.js"],
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["content/page-hook.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
